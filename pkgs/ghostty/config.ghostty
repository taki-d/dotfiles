# Font
font-family = Monaco
font-size = 14

# Window
window-padding-x = 2
window-padding-y = 2
background-opacity = 0.95

# Apply opacity to backgrounds drawn by applications such as Neovim and tmux.
background-opacity-cells = true

# Gruvbox Dark
background = 282828
foreground = ebdbb2

palette = 0=282828
palette = 1=cc241d
palette = 2=98971a
palette = 3=d79921
palette = 4=458588
palette = 5=b16286
palette = 6=689d6a
palette = 7=a89984
palette = 8=928374
palette = 9=fb4934
palette = 10=b8bb26
palette = 11=fabd2f
palette = 12=83a598
palette = 13=d3869b
palette = 14=8ec07c
palette = 15=ebdbb2

# Match Alacritty's default cursor and selection behavior.
cursor-style = block
cursor-style-blink = false
copy-on-select = false

# Ghostty integration
shell-integration = detect
shell-integration-features = sudo,ssh-env,ssh-terminfo
